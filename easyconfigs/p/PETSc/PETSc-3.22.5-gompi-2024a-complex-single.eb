#easyblock = 'PETSc'

name = 'PETSc'
version = '3.22.5'
versionsuffix = '-complex-single-flexiblas'

scalar_type = 'complex'
precision = 'single'
shared_libs = True

homepage = 'https://www.mcs.anl.gov/petsc'
description = """PETSc, pronounced PET-see (the S is silent), is a suite of data structures and routines for the
 scalable (parallel) solution of scientific applications modeled by partial differential equations."""

toolchain = {'name': 'gompi', 'version': '2024a'}
toolchainopts = {'openmp': True, 'usempi': True, 'pic': True}

source_urls = [
    'https://gitlab.com/petsc/petsc/-/archive/v%(version)s/',
]
sources = ['%(namelower)s-v%(version)s.tar.gz']
checksums = ['69ee2bb9e17867b4f7a3875023708891b66cd811d967b0612acbe7391018dca7']

builddependencies = [('CMake', '3.29.3')]

dependencies = [
    ('Python', '3.12.3'),
    ('FlexiBLAS', '3.4.4'),
]

configopts = ' --LIBS="$LIBS -lrt" '

moduleclass = 'numlib'
